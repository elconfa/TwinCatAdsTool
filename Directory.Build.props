<Project>

  <!-- One version for every assembly. The release workflow overrides it with the tag that is
       being built, so the tag, the binary and the version on screen cannot drift apart. -->
  <PropertyGroup>
    <Version>1.5.1</Version>
  </PropertyGroup>

  <!-- Lets the wpf projects be compile checked on macos and linux. Building for windows from a
       non windows host needs the windows targeting pack, which ships as a nuget package from
       .net 6 onwards. Running the application still requires windows. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
