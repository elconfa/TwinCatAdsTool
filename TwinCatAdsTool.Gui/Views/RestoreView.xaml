<UserControl x:Class="TwinCatAdsTool.Gui.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TwinCatAdsTool.Gui.ViewModels"
             xmlns:properties="clr-namespace:TwinCatAdsTool.Gui.Properties"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <!--  One row per variable: name on the left, its json on the right.  -->
        <DataTemplate x:Key="VariableTemplate" DataType="{x:Type viewModels:VariableViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           TextWrapping="Wrap"
                           Margin="0,6,12,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding Json}"
                         Style="{StaticResource MonoEdit}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static properties:Resources.Restore}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Write a saved backup back onto the plc."
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,16" />

        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Margin="{StaticResource StackedItemMargin}">
            <StackPanel>
                <StackPanel Style="{StaticResource Toolbar}">
                    <ui:Button Command="{Binding Load}"
                               Style="{StaticResource ToolbarButton}"
                               Content="{x:Static properties:Resources.Load}"
                               Icon="{ui:SymbolIcon FolderOpen24}" />

                    <ui:Button Command="{Binding Write}"
                               Style="{StaticResource ToolbarPrimaryButton}"
                               Content="{x:Static properties:Resources.Write}"
                               Icon="{ui:SymbolIcon ArrowUpload24}" />

                    <ui:Button Command="{Binding ShowReport}"
                               Style="{StaticResource ToolbarButton}"
                               Content="Report"
                               Icon="{ui:SymbolIcon DocumentBulletList24}" />

                    <!--  What is loaded matters before pressing write, not after.  -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Visibility="{Binding HasSourceFile, Converter={StaticResource VisibleIfTrue}}">
                        <ui:SymbolIcon Symbol="Document24" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SourceFile}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VariableCount, StringFormat=' · {0} variables'}"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfBusy}}">
                    <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="4" />
                    <TextBlock Text="{Binding CurrentTask}"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Left"
                               Margin="0,6,0,0" />
                </StackPanel>

                <ui:InfoBar Title="{Binding ReportTitle}"
                            Message="{Binding LastReportSummary}"
                            Severity="{Binding ReportSeverity}"
                            IsOpen="{Binding HasReport, Mode=TwoWay}"
                            IsClosable="True"
                            Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentSurface}">
            <!--
                Pixel scrolling keeps the rows virtualised even though they differ in height; the
                old view turned virtualisation off entirely and paid for it on large backups.
            -->
            <ListBox ItemsSource="{Binding DisplayVariables}"
                     ItemTemplate="{StaticResource VariableTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,8"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Border>
    </Grid>
</UserControl>
