<UserControl x:Class="TwinCatAdsTool.Gui.Views.ConnectionCabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TwinCatAdsTool.Gui.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:properties="clr-namespace:TwinCatAdsTool.Gui.Properties"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:ConnectionStateToBoolConverter x:Key="ConnectionStateToIsDisconnected" IfDisconnected="True"
                                                   IfConnected="False" />
        <converters:ConnectionStateToVisibilityConverter x:Key="VisibleIfDisconnected" IfConnected="Collapsed"
                                                         IfDisconnected="Visible" />
        <converters:ConnectionStateToVisibilityConverter x:Key="VisibleIfConnected" IfConnected="Visible"
                                                         IfDisconnected="Collapsed" />
        <converters:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrush" />
        <converters:NumberBoxValueConverter x:Key="NumberBoxValue" />
    </UserControl.Resources>

    <!--
        One row instead of the three stacked panels this used to be: the connection is a single
        piece of state and reads as one.
    -->
    <Border Style="{StaticResource SurfaceCard}"
            Margin="20,8,20,12"
            Padding="16,12">
        <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="DEVICE" Style="{StaticResource SectionCaption}" />
                <ComboBox ItemsSource="{Binding AmsNetIds}"
                          SelectedValue="{Binding SelectedAmsNetId}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding ConnectionState, Converter={StaticResource ConnectionStateToIsDisconnected}}"
                          MinWidth="170" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{x:Static properties:Resources.Address}" Style="{StaticResource SectionCaption}" />
                <ui:TextBox Text="{Binding SelectedNetId, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding ConnectionState, Converter={StaticResource ConnectionStateToIsDisconnected}}"
                            PlaceholderText="1.2.3.4.1.1"
                            MinWidth="180" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,20,0">
                <TextBlock Text="{x:Static properties:Resources.Port}" Style="{StaticResource SectionCaption}" />
                <ui:NumberBox Value="{Binding Port, Converter={StaticResource NumberBoxValue}}"
                              IsEnabled="{Binding ConnectionState, Converter={StaticResource ConnectionStateToIsDisconnected}}"
                              Minimum="1"
                              Maximum="65535"
                              MaxDecimalPlaces="0"
                              ClearButtonEnabled="False"
                              SpinButtonPlacementMode="Hidden"
                              MinWidth="90" />
            </StackPanel>

            <!--  Status reads as a sentence rather than an icon whose meaning has to be recalled.  -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,6">
                <Ellipse Style="{StaticResource StatusDot}"
                         Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToBrush}}" />
                <TextBlock Text="{Binding ConnectionState}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="{Binding AdsStatus}" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <Grid Grid.Column="4" VerticalAlignment="Bottom">
                <ui:Button Command="{Binding Connect}"
                           Visibility="{Binding ConnectionState, Converter={StaticResource VisibleIfDisconnected}}"
                           Content="{x:Static properties:Resources.Connect}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon PlugConnected24}"
                           Padding="14,6" />
                <ui:Button Command="{Binding Disconnect}"
                           Visibility="{Binding ConnectionState, Converter={StaticResource VisibleIfConnected}}"
                           Content="{x:Static properties:Resources.Disconnect}"
                           Icon="{ui:SymbolIcon PlugDisconnected24}"
                           Padding="14,6" />
            </Grid>
        </Grid>

        <!--  A failed connect used to be indistinguishable from a button that does nothing.  -->
        <ui:InfoBar Title="Could not connect"
                    Message="{Binding ConnectionError}"
                    Severity="Error"
                    IsOpen="{Binding HasConnectionError, Mode=TwoWay}"
                    IsClosable="True"
                    Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</UserControl>
