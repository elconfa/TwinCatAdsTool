<UserControl x:Class="TwinCatAdsTool.Gui.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:TwinCatAdsTool.Gui.Properties"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static properties:Resources.Backup}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Read every persistent variable of the plc and store it as json."
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,16" />

        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Margin="{StaticResource StackedItemMargin}">
            <StackPanel>
                <StackPanel Style="{StaticResource Toolbar}">
                    <ui:Button Command="{Binding Read}"
                               Style="{StaticResource ToolbarPrimaryButton}"
                               Content="{x:Static properties:Resources.ReadFromPLC}"
                               Icon="{ui:SymbolIcon ArrowDownload24}" />

                    <ui:Button Command="{Binding Save}"
                               Style="{StaticResource ToolbarButton}"
                               Content="{x:Static properties:Resources.SaveToFile}"
                               Icon="{ui:SymbolIcon Save24}" />

                    <ui:Button Command="{Binding ShowReport}"
                               Style="{StaticResource ToolbarButton}"
                               Content="Report"
                               Icon="{ui:SymbolIcon DocumentBulletList24}" />
                </StackPanel>

                <!--  Reading a full plc takes a while: show how far it got, not just that it runs.  -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfBusy}}">
                    <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="4" />
                    <TextBlock Text="{Binding CurrentTask}"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Left"
                               Margin="0,6,0,0" />
                </StackPanel>

                <ui:InfoBar Title="{Binding ReportTitle}"
                            Message="{Binding LastReportSummary}"
                            Severity="{Binding ReportSeverity}"
                            IsOpen="{Binding HasReport, Mode=TwoWay}"
                            IsClosable="True"
                            Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ContentSurface}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding BackupText}" Style="{StaticResource MonoDisplay}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
