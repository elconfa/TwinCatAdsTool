<UserControl x:Class="TwinCatAdsTool.Gui.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:TwinCatAdsTool.Gui.Models"
             xmlns:properties="clr-namespace:TwinCatAdsTool.Gui.Properties"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <!--
            The row owns its colours and stretches across the whole width. Handing the view ready
            made ListBoxItem controls, as this used to do, meant the list wrapped each one in a
            container of its own whose style decided the width and the background - which is why
            the differences ended up not showing.
        -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type models:DiffLine}">
            <Border x:Name="Row"
                    Height="20"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="3,0,0,0">
                <TextBlock Text="{Binding Text}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </Border>
            <DataTemplate.Triggers>
                <!--  Translucent fills: they read the same on a dark and on a light background.  -->
                <DataTrigger Binding="{Binding Kind}" Value="Inserted">
                    <Setter TargetName="Row" Property="Background" Value="#3810893E" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="#FF10893E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                    <Setter TargetName="Row" Property="Background" Value="#38E81123" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="#FFE81123" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Modified">
                    <Setter TargetName="Row" Property="Background" Value="#38F7630C" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="#FFF7630C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Filler">
                    <Setter TargetName="Row" Property="Background" Value="#14808080" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            No selection chrome and no padding of its own: a diff row is read, not picked, and
            anything the container drew would sit on top of the colour that carries the meaning.
        -->
        <Style x:Key="DiffRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Scrollbars of their own rather than the ones wpf ui draws, which are a few pixels wide
            and only widen once the pointer is already on them - too fine a target for a pane that
            is scrolled constantly. Colours stay theme aware through DynamicResource.
        -->
        <Style x:Key="DiffScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource TextFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                Margin="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Clicking the empty part of the track pages up or down; it draws nothing of its own.  -->
        <Style x:Key="DiffScrollBarPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DiffScrollBarVertical" TargetType="ScrollBar">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DiffScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DiffScrollBarThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DiffScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="DiffScrollBarHorizontal" TargetType="ScrollBar">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DiffScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DiffScrollBarThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource DiffScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <!--
            Virtualised and scrolling by line. A backup of a real plant is well over ten thousand
            lines: realising them all is what made the wheel feel dead. Scrolling by line rather
            than by pixel also keeps the two panes exactly aligned, since every row is 20 high.
        -->
        <Style x:Key="DiffPane" TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate" Value="{StaticResource DiffLineTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DiffRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!--
                            A plain ScrollViewer. The one wpf ui puts in its own list template is a
                            PassiveScrollViewer, which by design does not act on the mouse wheel and
                            lets it bubble to whatever is above - which is why the wheel worked only
                            while the pointer was over the scrollbar and did nothing over the rows.

                            The scrollbar settings above are attached properties that inherit down
                            the tree, so they reach this ScrollViewer without being restated.
                        -->
                        <ScrollViewer Focusable="False">
                            <ScrollViewer.Resources>
                                <!--
                                    Declared here, on the scroll viewer itself, so that the
                                    scrollbars built inside its own template are certain to find
                                    it: an implicit style further out is not guaranteed to reach
                                    across a template boundary.
                                -->
                                <Style TargetType="ScrollBar">
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="MinWidth" Value="16" />
                                    <Setter Property="Template" Value="{StaticResource DiffScrollBarVertical}" />
                                    <Style.Triggers>
                                        <Trigger Property="Orientation" Value="Horizontal">
                                            <Setter Property="Width" Value="Auto" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Height" Value="16" />
                                            <Setter Property="MinHeight" Value="16" />
                                            <Setter Property="Template" Value="{StaticResource DiffScrollBarHorizontal}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Resources>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{x:Static properties:Resources.Compare}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <!--  Whether anything differs at all is the first thing the user wants to know.  -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasComparison, Converter={StaticResource VisibleIfTrue}}">
            <ui:InfoBadge Severity="Success"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfTrue}}" />
            <ui:InfoBadge Severity="Caution"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfFalse}}" />
            <TextBlock Text="The two sides are identical"
                       VerticalAlignment="Center"
                       Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfTrue}}" />
            <TextBlock Text="{Binding DifferenceCount, StringFormat='{}{0} differing lines'}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfFalse}}" />
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12" Padding="12">
            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button Command="{Binding ReadLeft}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.ReadFromPLC}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button Command="{Binding LoadLeft}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.LoadFromFile}"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
                <TextBlock Text="{Binding SourceLeft}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12" Padding="12">
            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button Command="{Binding ReadRight}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.ReadFromPLC}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button Command="{Binding LoadRight}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.LoadFromFile}"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
                <TextBlock Text="{Binding SourceRight}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ContentSurface}">
            <ListBox x:Name="LeftPane"
                     ItemsSource="{Binding LeftLines}"
                     Style="{StaticResource DiffPane}"
                     ScrollViewer.ScrollChanged="PaneScrolled" />
        </Border>

        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ContentSurface}">
            <ListBox x:Name="RightPane"
                     ItemsSource="{Binding RightLines}"
                     Style="{StaticResource DiffPane}"
                     ScrollViewer.ScrollChanged="PaneScrolled" />
        </Border>
    </Grid>
</UserControl>
