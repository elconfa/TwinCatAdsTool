<UserControl x:Class="TwinCatAdsTool.Gui.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:TwinCatAdsTool.Gui.Models"
             xmlns:properties="clr-namespace:TwinCatAdsTool.Gui.Properties"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <!--
            The stripe down the left of a row. Colour on a cell background has to survive whatever
            the theme paints over it; a border of its own always renders, so the kind of a
            difference is readable whichever theme and whichever wpf ui version is in force.
        -->
        <Style x:Key="KindStripe" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{x:Static properties:Resources.Compare}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">

            <!--  Whether anything differs at all is the first thing the user wants to know.  -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasComparison, Converter={StaticResource VisibleIfTrue}}">
                <ui:InfoBadge Severity="Success"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfTrue}}" />
                <ui:InfoBadge Severity="Caution"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfFalse}}" />
                <TextBlock Text="The two sides are identical"
                           VerticalAlignment="Center"
                           Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfTrue}}" />
                <TextBlock Text="{Binding DifferenceCount, StringFormat='{}{0} values differ'}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding AreIdentical, Converter={StaticResource VisibleIfFalse}}" />

                <!--  Marks are not writes. Saying how many are waiting is what keeps that clear.  -->
                <TextBlock Text="{Binding MarkedCount, StringFormat='{}, {0} picked to write'}"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           Visibility="{Binding HasMarks, Converter={StaticResource VisibleIfTrue}}" />
            </StackPanel>

            <!--  Says what is in the way - one side missing, no plc, no connection.  -->
            <TextBlock Text="{Binding MergeHint}"
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasMergeHint, Converter={StaticResource VisibleIfTrue}}" />
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12" Padding="12">
            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button Command="{Binding ReadLeft}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.ReadFromPLC}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button Command="{Binding LoadLeft}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.LoadFromFile}"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
                <TextBlock Text="{Binding SourceLeft}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12" Padding="12">
            <StackPanel Style="{StaticResource Toolbar}">
                <ui:Button Command="{Binding ReadRight}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.ReadFromPLC}"
                           Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button Command="{Binding LoadRight}"
                           Style="{StaticResource ToolbarButton}"
                           Content="{x:Static properties:Resources.LoadFromFile}"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
                <TextBlock Text="{Binding SourceRight}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Border>

        <!--
            Picking values, moving between them, and one deliberate action that writes. Nothing on
            this bar touches the plc except the last button: a comparison that wrote as soon as an
            arrow was clicked would be a comparison nobody could safely explore.
        -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource SurfaceCard}"
                Margin="0,0,0,12" Padding="12"
                Visibility="{Binding HasComparison, Converter={StaticResource VisibleIfTrue}}">
            <StackPanel>
                <WrapPanel>
                    <ui:Button Command="{Binding CmdFirstChange}"
                               Appearance="Transparent" Padding="8" Margin="0,0,2,4"
                               ToolTip="First difference"
                               Icon="{ui:SymbolIcon ChevronDoubleUp20}" />
                    <ui:Button Command="{Binding CmdPreviousChange}"
                               Appearance="Transparent" Padding="8" Margin="0,0,2,4"
                               ToolTip="Previous difference"
                               Icon="{ui:SymbolIcon ChevronUp24}" />
                    <ui:Button Command="{Binding CmdNextChange}"
                               Appearance="Transparent" Padding="8" Margin="0,0,2,4"
                               ToolTip="Next difference"
                               Icon="{ui:SymbolIcon ChevronDown24}" />
                    <ui:Button Command="{Binding CmdLastChange}"
                               Appearance="Transparent" Padding="8" Margin="0,0,16,4"
                               ToolTip="Last difference"
                               Icon="{ui:SymbolIcon ChevronDoubleDown20}" />

                    <CheckBox IsChecked="{Binding OnlyDifferences, Mode=TwoWay}"
                              Content="Only differences"
                              VerticalAlignment="Center"
                              Margin="0,0,16,4"
                              ToolTip="Off, every value of the backup is listed, not only what changed" />

                    <ui:Button Command="{Binding CmdCopyAllToLeft}"
                               IsEnabled="{Binding CanMergeToLeft}"
                               Appearance="Transparent" Padding="8,6" Margin="0,0,6,4"
                               Content="All to left"
                               ToolTip="Pick every difference to be taken from the right onto the left"
                               Icon="{ui:SymbolIcon ArrowCircleLeft24}" />
                    <ui:Button Command="{Binding CmdCopyAllToRight}"
                               IsEnabled="{Binding CanMergeToRight}"
                               Appearance="Transparent" Padding="8,6" Margin="0,0,6,4"
                               Content="All to right"
                               ToolTip="Pick every difference to be taken from the left onto the right"
                               Icon="{ui:SymbolIcon ArrowCircleRight24}" />

                    <ui:Button Command="{Binding CmdUndoAll}"
                               IsEnabled="{Binding HasMarks}"
                               Appearance="Transparent" Padding="8,6" Margin="0,0,16,4"
                               Content="Undo all"
                               ToolTip="Take back every pick. Nothing has been written yet"
                               Icon="{ui:SymbolIcon ArrowUndo24}" />

                    <ui:Button Command="{Binding CmdApply}"
                               IsEnabled="{Binding CanApply}"
                               Appearance="Primary" Padding="12,6" Margin="0,0,0,4"
                               Content="Write to plc"
                               ToolTip="Write the picked values, and nothing else, onto the plc"
                               Icon="{ui:SymbolIcon ArrowUpload24}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ContentSurface}">
            <ui:DataGrid x:Name="DifferenceGrid"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         SelectionChanged="RowSelected"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         SelectionUnit="FullRow"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         EnableRowVirtualization="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Background="Transparent"
                         BorderThickness="0">

                <ui:DataGrid.Columns>

                    <!--  The kind of difference, as a colour that is always drawn.  -->
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ValueDifference}">
                                <Border x:Name="Stripe" Style="{StaticResource KindStripe}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Changed">
                                        <Setter TargetName="Stripe" Property="Background" Value="#FFF7630C" />
                                        <Setter TargetName="Stripe" Property="ToolTip" Value="Both sides have this value and they disagree" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OnlyOnLeft">
                                        <Setter TargetName="Stripe" Property="Background" Value="#FFE81123" />
                                        <Setter TargetName="Stripe" Property="ToolTip" Value="Only the left side has this value" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="OnlyOnRight">
                                        <Setter TargetName="Stripe" Property="Background" Value="#FF10893E" />
                                        <Setter TargetName="Stripe" Property="ToolTip" Value="Only the right side has this value" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Which way this value has been picked to travel, once written.  -->
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ValueDifference}">
                                <Grid Width="20">
                                    <ui:SymbolIcon Symbol="ArrowCircleLeft20"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Picked: the left is to take the value on the right"
                                                   Visibility="Collapsed"
                                                   x:Name="ToLeft" />
                                    <ui:SymbolIcon Symbol="ArrowCircleRight20"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Picked: the right is to take the value on the left"
                                                   Visibility="Collapsed"
                                                   x:Name="ToRight" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Mark}" Value="ToLeft">
                                        <Setter TargetName="ToLeft" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mark}" Value="ToRight">
                                        <Setter TargetName="ToRight" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--
                        The path is the whole point of comparing this way: it names one symbol on
                        the plc, which is what a write has to be addressed to.
                    -->
                    <DataGridTextColumn Header="Variable" Width="*" Binding="{Binding Path}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValueCell}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Left" Width="Auto" MinWidth="90" Binding="{Binding LeftText}"
                                        ElementStyle="{StaticResource ValueCell}" />

                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ValueDifference}">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsMergeable, Converter={StaticResource VisibleIfTrue}}">
                                    <ui:Button Command="{Binding Path=DataContext.CmdCopyToLeft, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding Path=DataContext.CanMergeToLeft, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                               Appearance="Transparent"
                                               Padding="6" Margin="2"
                                               ToolTip="Take the value on the right onto the left. Click again to take it back"
                                               Icon="{ui:SymbolIcon ArrowCircleLeft20}" />
                                    <ui:Button Command="{Binding Path=DataContext.CmdCopyToRight, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding Path=DataContext.CanMergeToRight, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                               Appearance="Transparent"
                                               Padding="6" Margin="2"
                                               ToolTip="Take the value on the left onto the right. Click again to take it back"
                                               Icon="{ui:SymbolIcon ArrowCircleRight20}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Right" Width="Auto" MinWidth="90" Binding="{Binding RightText}"
                                        ElementStyle="{StaticResource ValueCell}" />

                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</UserControl>
