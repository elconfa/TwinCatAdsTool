<Application x:Class="TwinCatAdsTool.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:TwinCatAdsTool.Gui"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--
                    Dark is the starting theme; ApplicationThemeManager swaps it at runtime when
                    the user toggles it from the title bar. Merged first so the styles below can
                    resolve the tokens by StaticResource.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/TwinCatAdsTool.Gui;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Deferred on purpose: the real locator, the one holding the ninject kernel, is put
                under this key by Program.ReplaceViewModelLocator before anything looks it up.
            -->
            <gui:ViewModelLocator x:Key="Locator" />

            <!--
                Xceed ships no fluent template for these. Giving them the theme brushes stops them
                from showing up as light grey boxes in a dark window.
            -->
            <Style TargetType="xctk:DateTimePicker" BasedOn="{StaticResource XceedInput}" />
            <Style TargetType="xctk:ByteUpDown" BasedOn="{StaticResource XceedInput}" />
            <Style TargetType="xctk:IntegerUpDown" BasedOn="{StaticResource XceedInput}" />
            <Style TargetType="xctk:TimeSpanUpDown" BasedOn="{StaticResource XceedInput}" />
            <Style TargetType="xctk:SingleUpDown" BasedOn="{StaticResource XceedInput}" />
            <Style TargetType="xctk:DoubleUpDown" BasedOn="{StaticResource XceedInput}" />

        </ResourceDictionary>

    </Application.Resources>
</Application>
