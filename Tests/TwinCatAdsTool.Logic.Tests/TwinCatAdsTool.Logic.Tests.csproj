<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The test project runs on the sdk installed on the developer machine; the app itself
         still targets net5.0. Only the tested code has to be net5.0 compatible. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TwinCatAdsTool.Logic\TwinCatAdsTool.Logic.csproj" />
    <ProjectReference Include="..\..\TwinCatAdsTool.Interfaces\TwinCatAdsTool.Interfaces.csproj" />
  </ItemGroup>

</Project>
