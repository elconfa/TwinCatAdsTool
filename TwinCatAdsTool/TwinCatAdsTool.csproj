<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>twincat.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwinCatAdsTool.Gui\TwinCatAdsTool.Gui.csproj" />
    <ProjectReference Include="..\TwinCatAdsTool.Interfaces\TwinCatAdsTool.Interfaces.csproj" />
    <ProjectReference Include="..\TwinCatAdsTool.Logic\TwinCatAdsTool.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Program.CreateLogger looks for this next to the executable. Copying it to the output
           only is not enough: without these a published build silently falls back to
           BasicConfigurator and logs to a console FreeConsole has already closed.
           ExcludeFromSingleFile keeps it out of the bundle - content packed into the single file
           is unpacked into a temporary folder, not next to the executable, so the logger would
           still not find it. It has to stay a plain file the user can also edit. -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
